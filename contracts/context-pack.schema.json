{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "query", "intent", "budget", "content", "citations", "warnings", "snapshotAt"],
  "properties": {
    "projectId": {"type": "string", "minLength": 1},
    "query": {"type": "string"},
    "intent": {"type": "string"},
    "budget": {
      "type": "object",
      "required": ["maxChars", "maxItems"],
      "properties": {
        "maxChars": {"type": "integer", "minimum": 1000, "maximum": 200000},
        "maxItems": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    },
    "content": {"type": "string"},
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uri", "targetType", "targetId", "reason"],
        "properties": {
          "uri": {"type": "string", "pattern": "^memory://"},
          "targetType": {"type": "string"},
          "targetId": {"type": "string"},
          "versionId": {"type": ["string", "null"]},
          "contentHash": {"type": ["string", "null"]},
          "status": {"type": ["string", "null"]},
          "reason": {"type": "string"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "snapshotAt": {"type": "string", "format": "date-time"},
    "trace": {"type": ["object", "null"]}
  }
}
